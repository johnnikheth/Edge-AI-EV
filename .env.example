# .env.example — copy to .env and fill in real values before deploying.
# Never commit .env to git. Add it to .gitignore.
#
# Load with:  export $(grep -v '^#' .env | xargs)   (Linux/macOS)
#             Get-Content .env | ForEach-Object { if ($_ -notmatch '^#') { $k,$v = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k, $v) } }  (PowerShell)

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Set this to any strong random string (e.g. openssl rand -hex 32).
# Leave blank to run open on localhost only. REQUIRED for any internet-facing deploy.
DEPOT_TOKEN=

# ── watsonx.ai (Granite) ─────────────────────────────────────────────────────
# IBM Cloud IAM API key — create at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# watsonx.ai project GUID — copy from your project settings in watsonx.ai
WATSONX_PROJECT_ID=

# Optional — defaults to us-south
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional — defaults to ibm/granite-3-8b-instruct
# WATSONX_MODEL=ibm/granite-3-8b-instruct

# ── Public data feeds (all optional) ─────────────────────────────────────────

# OpenEI Utility Rate Database — tariffs from https://openei.org/services/doc/rest/util_rates/
# Free key, no quota listed. Without it the server uses the rate-limited DEMO_KEY.
# Register at: https://openei.org/user/register
OPENEI_API_KEY=

# 511 SF Bay live traffic — free token, 60 req/hour
# Register at: https://511.org/open-data/token
SF511_API_KEY=

# NREL PVWatts v8 — solar production estimates
# Free key, rate-limited at 1000 req/day without. Without it the server uses DEMO_KEY.
# Register at: https://developer.nrel.gov/signup/
NREL_API_KEY=

# ── Storage / container deploy ────────────────────────────────────────────────
# Absolute path for data.db. Leave blank for local dev (defaults to repo root).
# In IBM Cloud Code Engine set this to the persistent volume mount path:
# DB_PATH=/data/data.db
DB_PATH=

# ── SSL (optional, for corporate TLS proxies) ─────────────────────────────────
# Path to a CA bundle PEM file if your machine has custom root certs
# SSL_CERT_FILE=/path/to/ca-bundle.pem
